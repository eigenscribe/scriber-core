{
  // EigenScribe Color Scheme for Sublime Text 4
  // =============================================
  // Based on the There and Back Again PreTeXt project palette.
  // Cyan-to-purple gradient aesthetic with glassmorphic dark surfaces.
  // Uses Aclonica for UI headings and Fira Code for code.

  "name": "EigenScribe",
  "author": "Sofia (EigenScribe)",

  // ============================================================
  //  COLOR PALETTE — extracted from theme-variables.css
  // ============================================================
  "colors": {
    "bg": "#0d1117",
    "bg-surface": "#161b22",
    "bg-code": "#1a1d24",
    "bg-panel": "#232830",
    "bg-gutter": "#0d1117",
    "bg-line-highlight": "rgba(20, 181, 255, 0.06)",
    "bg-selection": "rgba(20, 181, 255, 0.20)",
    "bg-selection-inop": "rgba(20, 181, 255, 0.10)",
    "bg-find-highlight": "rgba(254, 181, 56, 0.30)",
    "bg-find-range": "rgba(254, 181, 56, 0.12)",
    "bg-bracket-fg": "#14b5ff",
    "bg-bracket-bg": "rgba(20, 181, 255, 0.25)",
    "bg-tag": "rgba(121, 82, 245, 0.15)",

    "fg": "#C5F8FF",
    "fg-muted": "#8b949e",
    "fg-comment": "#4c739c",
    "fg-cyan": "#14b5ff",
    "fg-bright-cyan": "#00e8ff",
    "fg-purple": "#7952f5",
    "fg-light-purple": "#9b7dff",
    "fg-magenta": "#ff75c3",
    "fg-green": "#00e000",
    "fg-bright-green": "#38fe52",
    "fg-yellow": "#feb538",
    "fg-number-purple": "#be58f9",
    "fg-pink": "#fe38e4",
    "fg-indigo": "#6f78fa",
    "fg-operator": "#939af8",
    "fg-inline-code": "#ff75c3",

    "border": "rgba(255, 255, 255, 0.08)",
    "border-accent": "rgba(20, 181, 255, 0.35)",
    "border-active": "#14b5ff"
  },

  // ============================================================
  //  SYNTAX SCOPE STYLES
  // ============================================================
  "rules": [
    // Default / plain text
    {"foreground": "fg", "settings": "default"},

    // Comments — muted blue, italic
    {"foreground": "fg-comment", "font_style": "italic", "scope": "comment"},
    {"foreground": "fg-comment", "font_style": "italic", "scope": "comment.line"},
    {"foreground": "fg-comment", "font_style": "italic", "scope": "comment.block"},
    {"foreground": "fg-comment", "font_style": "italic", "scope": "comment.block.documentation"},
    {"foreground": "fg-comment", "font_style": "italic", "scope": "punctuation.definition.comment"},

    // Prolog, DOCTYPE, XML declaration — bright green
    {"foreground": "fg-bright-green", "scope": "meta.tag.sgml.doctype, meta.tag.sgml.declaration, meta.tag.preprocessor"},

    // Keywords — cyan (matches XML tags, HTML tags, CSS selectors)
    {"foreground": "fg-cyan", "scope": "keyword, keyword.control, storage, storage.type, storage.modifier"},
    {"foreground": "fg-cyan", "scope": "keyword.other.doctype, keyword.other.doctype.html"},

    // Built-in functions, constants — bright cyan
    {"foreground": "fg-bright-cyan", "scope": "support.function, support.type, variable.language, constant.language"},

    // Variables — green
    {"foreground": "fg-green", "scope": "variable, variable.other, variable.parameter"},

    // Types, class names, parameters — yellow/amber
    {"foreground": "fg-yellow", "scope": "entity.name.type, entity.name.class, support.class, meta.type"},

    // Functions, methods — blue
    {"foreground": "fg-cyan", "scope": "entity.name.function, support.function, meta.function-call"},

    // Strings — magenta/pink
    {"foreground": "fg-magenta", "scope": "string, string.quoted, string.unquoted, string.interpolated, string.other"},
    {"foreground": "fg-magenta", "scope": "punctuation.definition.string"},

    // Numbers — purple
    {"foreground": "fg-number-purple", "scope": "constant.numeric, constant.number"},

    // Constants, booleans — pink
    {"foreground": "fg-pink", "scope": "constant, constant.language.boolean, constant.language.symbol, constant.other"},

    // Operators, punctuation — light indigo
    {"foreground": "fg-operator", "font_style": "bold", "scope": "keyword.operator, punctuation"},

    // Attributes, XML attribute names — indigo/purple
    {"foreground": "fg-indigo", "scope": "entity.other.attribute-name, meta.attribute-with-value"},

    // XML/HTML tags — cyan
    {"foreground": "fg-cyan", "scope": "punctuation.definition.tag, entity.name.tag"},

    // XML/HTML attribute values — magenta
    {"foreground": "fg-magenta", "scope": "meta.attribute-with-value string"},

    // Preprocessor, decorators — bright green
    {"foreground": "fg-bright-green", "scope": "meta.preprocessor, meta.decorator, punctuation.definition.decorator"},

    // URLs — blue
    {"foreground": "fg-cyan", "scope": "constant.other.reference.link, markup.underline.link"},

    // Markdown-specific
    {"foreground": "fg-cyan", "font_style": "bold", "scope": "markup.heading, markup.heading.entity, markup.heading.markdown punctuation.definition.heading"},
    {"foreground": "fg-bright-cyan", "font_style": "bold", "scope": "markup.heading.1"},
    {"foreground": "fg-cyan", "font_style": "bold", "scope": "markup.heading.2"},
    {"foreground": "fg-light-purple", "font_style": "bold", "scope": "markup.heading.3"},
    {"foreground": "fg-purple", "font_style": "bold", "scope": "markup.heading.4"},
    {"foreground": "fg-magenta", "font_style": "italic", "scope": "markup.italic"},
    {"foreground": "fg-magenta", "font_style": "bold", "scope": "markup.bold"},
    {"foreground": "fg-magenta", "font_style": "bold italic", "scope": "markup.bold markup.italic"},
    {"foreground": "fg-inline-code", "scope": "markup.inline.raw, markup.raw"},
    {"foreground": "fg-cyan", "scope": "markup.link, markup.underline.link"},
    {"foreground": "fg-comment", "font_style": "italic", "scope": "markup.strikethrough"},
    {"foreground": "fg-green", "scope": "markup.list"},
    {"foreground": "fg-yellow", "scope": "markup.quote"},
    {"foreground": "fg-muted", "scope": "meta.separator"},

    // LaTeX / MathJax math
    {"foreground": "fg-light-purple", "scope": "variable.other.math, support.function.math, constant.character.math"},
    {"foreground": "fg-bright-cyan", "scope": "support.class.math"},

    // Diff
    {"foreground": "fg-pink", "background": "rgba(255, 118, 161, 0.10)", "scope": "markup.deleted"},
    {"foreground": "fg-bright-green", "background": "rgba(56, 254, 82, 0.10)", "scope": "markup.inserted"},
    {"foreground": "fg-yellow", "background": "rgba(254, 181, 56, 0.10)", "scope": "markup.changed"},
    {"foreground": "fg-muted", "scope": "meta.diff.header"},

    // Regex
    {"foreground": "fg-magenta", "scope": "string.regexp, constant.character.escape"},

    // Invalid / errors
    {"foreground": "fg", "background": "rgba(255, 64, 161, 0.30)", "scope": "invalid"},
    {"foreground": "fg", "background": "rgba(255, 118, 161, 0.20)", "scope": "invalid.deprecated"},

    // Regions / fold markers
    {"foreground": "fg-bright-green", "scope": "comment.line.region, punctuation.definition.comment region"},

    // YAML (for PreTeXt frontmatter-like metadata)
    {"foreground": "fg-indigo", "scope": "keyword.other.yaml"},
    {"foreground": "fg-cyan", "scope": "string.unquoted.yaml, support.type.yaml"},

    // JSON
    {"foreground": "fg-indigo", "scope": "support.type.property-name.json"},
    {"foreground": "fg-magenta", "scope": "string.quoted.json"},
    {"foreground": "fg-number-purple", "scope": "constant.json"},

    // Python
    {"foreground": "fg-cyan", "scope": "keyword.control.python, storage.type.function.python"},
    {"foreground": "fg-bright-cyan", "scope": "support.function.builtin.python"},
    {"foreground": "fg-yellow", "scope": "support.type.python, storage.type.class.python"},
    {"foreground": "fg-green", "scope": "variable.parameter.python"},
    {"foreground": "fg-bright-green", "scope": "meta.function.decorator.python, punctuation.definition.decorator.python"},

    // CSS
    {"foreground": "fg-cyan", "scope": "entity.name.tag.css, entity.name.tag.css punctuation.definition.tag"},
    {"foreground": "fg-indigo", "scope": "support.type.property-name.css"},
    {"foreground": "fg-number-purple", "scope": "constant.numeric.css, support.constant"},
    {"foreground": "fg-magenta", "scope": "string.quoted.css, support.function"},
    {"foreground": "fg-yellow", "scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css"},

    // Shell / Bash
    {"foreground": "fg-cyan", "scope": "keyword.control, storage.type.function.shell"},
    {"foreground": "fg-green", "scope": "variable.other.normal.shell, variable.other.shell"},
    {"foreground": "fg-yellow", "scope": "support.function.builtin.shell"}
  ],

  // ============================================================
  //  UI / LAYOUT COLORS
  // ============================================================
  "defaults": {
    "background": "bg",
    "foreground": "fg",
    "caret": "fg-bright-cyan",
    "lineHighlight": "bg-line-highlight",
    "selection": "bg-selection",
    "selectionBorder": "border-accent",
    "selectionBorderWidth": "1.0",
    "inactiveSelection": "bg-selection-inop",
    "findHighlight": "bg-find-highlight",
    "findHighlightForeground": "bg",
    "bracketForeground": "bg-bracket-fg",
    "bracketContentsOptions": "match_adjacent",
    "bracketContentsForeground": "fg-cyan",
    "bracketContentsBackground": "bg-bracket-bg",
    "gutterForeground": "fg-muted",
    "gutterBackground": "bg-gutter",
    "firstColumnGuide": "border-accent",
    "activeGuide": "fg-cyan",
    "magnifiedGuide": "fg-bright-cyan",
    "indentGuide": "rgba(255, 255, 255, 0.04)",
    "indentGuideActive": "rgba(20, 181, 255, 0.20)",
    "stackGuideWidth": "1",
    "stackGuideColour": "border",
    "caretstyle": "block",
    "fontface": "Fira Code",
    "fontsize": "14"
  }
}
